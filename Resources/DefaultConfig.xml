<?xml version="1.0" encoding="utf-8" ?>

<!-- File: Config.xml -->

<Config>
  <!-- s = stretch factor, r = range. Finite(s, r), BiFinite(s, r), Infinite(s), BiInfinite(s) -->
  <!-- r = Inf/Infinity => Infinite(s), BiInfinite(s) -->
  <RadialMap> Finite(1e-2, 1e7) </RadialMap>

  <!-- Physics parameters: all value-provided, all treated as double. -->
  <Parameters>
    <sigma> 0.1 </sigma>
    <gamma> 1.0 </gamma>
    <mu> 0.0 </mu>
    <m> 1 </m>
    <k> 1.0 </k>
  </Parameters>

  <!-- System Functions. Definitions must follow C# Math syntax. Free variable is explicitly typed here; all other symbols are taken from <Parameters>. -->
  <EquationCoefficients free="double rho">
    <!-- omega^0 coefficients -->
    <EC i="0" j="0"> - (Math.Pow(rho, 8 * sigma * sigma / (1 - 2 * sigma)) * (m * m * Math.Pow(gamma * rho, -2) + k * k * Math.Pow(rho, 4 * sigma) + mu * mu)) </EC>
    <EC i="0" j="1"> (1 - 4 * sigma) / ((1 - 2 * sigma) * rho) </EC>
    <EC i="0" j="2"> 1.0 </EC>

    <!-- omega^1 coefficients -->
    <EC i="1" j="0"> 0.0 </EC>
    <EC i="1" j="1"> 0.0 </EC>

    <!-- omega^2 coefficients -->
    <EC i="2" j="0"> Math.Pow(rho, -4 * sigma) </EC>
  </EquationCoefficients>

  <!-- Boundary conditions -->
  <!-- Real => (c), Complex => (a, b). Inf, Infinity => Dirichlet -->
  <BoundaryConditions>

    <!-- Dirichlet, Neumann, Robin(a, b), Robin(c), Sommerfeld(a, b), Sommerfeld(c) -->
    <!--Sommerfeld(Custom), Sommerfeld(Incoming), Sommerfeld(Outgoing) -->
    <Boundary>
      <Left> Neumann </Left>
      <Right> Sommerfeld(Outgoing) </Right>
    </Boundary>

    <!-- Sigma(omega) with omega as the only free variable. All other symbols come from <Parameters>. -->
    <Sigma free="Complex omega">
      <Left> Complex.ImaginaryOne * omega </Left>
      <Right> - Complex.ImaginaryOne * omega </Right>
    </Sigma>
  </BoundaryConditions>

  <!-- Automatic, Composite(c), Composite(a, b), Manual(c), Manual(a, b), Off, None -->
  <Transform>
    <Left> Manual(1.0, 1.0) </Left>
    <Right> Off </Right>
  </Transform>

  <!-- QNM Finder control parameters -->
  <QNMFinder>
    <!-- N: Collocation number, A: Accuracy -->
    <Guesser>
      <W> (0.0, 0.0) </W>
      <N> 128 </N>
      <A> 1e-10 </A>
    </Guesser>

    <!-- B: Beyn pencil width, C: Domain center, D: Domain edge, Q: Quality factor, R: Randomize Beyn pencil, S: Domain subdivision number -->
    <Primer>
      <!-- Number of vectors in Beyn's pencil -->
      <B> 16 </B>
      <!-- Domain specification -->
      <C> (0.0, 0.0) </C>
      <D> 5.0 </D>
      <!-- Beyn Pencil specification -->
      <Q> 8.0 </Q>
      <R> 1e-3 </R>
      <!-- Number of subdivision of the domain -->
      <S> 7 </S>
    </Primer>

    <!-- M: Quadrature number -->
    <Estimator>
      <M> 128 </M>
    </Estimator>

    <!-- E: Estimate count, L: Lapping number, P: Perturbation -->
    <Seeder>
      <E> 200 </E>
      <L> 8 </L>
      <P> 0.0 </P>
    </Seeder>

    <!-- I: Iteration count -->
    <Refiner>
      <I> 64 </I>
    </Refiner>

    <!-- U: Ultra-refinement mode -->
    <Feeder>
      <!-- Automatic, Manual, Off, All, Some, None -->
      <U> Some </U>
    </Feeder>

    <!-- J: Maximum refinement depth -->
    <Superfiner>
      <J> 3 </J>
    </Superfiner>
  </QNMFinder>

  <Settings>
    <!-- Toggle preloading objects to memory -->
    <Preload> True </Preload>

    <!-- Toggle printing to console -->
    <ConsolePrint> True </ConsolePrint>
  </Settings>

  <!-- Folder structure. Must match names in <Parameters>. -->
  <OutputPath>
    <Folder> sigma, gamma, mu </Folder>
    <Subfolder> m, k </Subfolder>
  </OutputPath>

</Config>
